FROM python:3.11-slim

ARG TARGETARCH

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    ca-certificates \
    curl \
    ffmpeg \
    git \
    libsndfile1 \
    python3-dev \
    unzip \
    && rm -rf /var/lib/apt/lists/*

ENV DENO_INSTALL="/opt/deno"
RUN curl -fsSL https://deno.land/install.sh | sh
ENV PATH="$DENO_INSTALL/bin:$PATH"
ENV HOME="/home/app"
ENV XDG_CACHE_HOME="/app/.cache"
ENV TORCH_HOME="/app/.cache/torch"
ENV MPLCONFIGDIR="/app/.cache/matplotlib"

COPY requirements.txt requirements-worker.txt requirements-ml.txt ./
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir cython "numpy<2.0" \
    && pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r requirements-worker.txt

# TensorFlow wheels are not published for linux/arm64; only install on amd64.
RUN if [ "$TARGETARCH" = "amd64" ]; then \
      pip install --no-cache-dir -r requirements-ml.txt; \
    else \
      echo "Skipping basic-pitch/tensorflow on $TARGETARCH"; \
    fi

RUN useradd --create-home --shell /usr/sbin/nologin app \
    && mkdir -p /app/temp /app/output /app/.cache \
    && chown -R app:app /app /opt/deno

COPY --chown=app:app . .

USER app

CMD ["celery", "-A", "app.tasks.celery_app", "worker", "--loglevel=info"]
